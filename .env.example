# All variables below are OPTIONAL — the app auto-generates and persists a
# session secret and VAPID push keys in the database on first run, so you
# don't need to set anything to get started. Copy this file to .env.local
# only if you want to pin these values manually (e.g. for a multi-instance
# deployment where every instance needs the same secret).

# Signing key for login sessions.
# SESSION_SECRET=

# Web Push (VAPID) keys — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Where the SQLite database file is stored (defaults to data/kraftskiva.db).
# DATABASE_PATH=
