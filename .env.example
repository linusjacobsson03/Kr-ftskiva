# All variables below are OPTIONAL for local development — without them the
# app uses a local SQLite file and auto-generates its own secrets, so you
# don't need to set anything to get started.
#
# For a production deployment without a persistent disk (Vercel, Netlify,
# etc.) set the two TURSO_* variables to a free database from turso.tech —
# see README.md for the two-minute setup. Copy this file to .env.local to
# use it locally.

# Free hosted SQLite-compatible database (https://turso.tech).
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Signing key for login sessions.
# SESSION_SECRET=

# Web Push (VAPID) keys — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Where the SQLite database file is stored (defaults to data/kraftskiva.db).
# DATABASE_PATH=
